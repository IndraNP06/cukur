{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Ran Cukurin",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:ea4gc68jTY4Ac58SALsY+pkie7roj2us2xqOyMjooPA=",
    "ASSET_URL": "/",
    "APP_STORAGE": "/tmp/storage",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "GOOGLE_SHEETS_ID": "16oP7uh_2RwNdQwW7ZBJFk12gq0Lv94dH4xPxU54ub0k",
    "GOOGLE_SHEETS_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbzMopEjpSC3tplC2qZOvSc44llTtB-I6RpM9Gn-XXu27kTMEYpmjvG7qWxH0hvdwfAH/exec",
    "APP_TIMEZONE": "Asia/Jakarta",
    "LOG_CHANNEL": "stderr"
  }
}
